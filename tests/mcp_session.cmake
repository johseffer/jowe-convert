# Drives `jvconvert mcp` over stdio with a scripted JSON-RPC session and checks every reply.
cmake_minimum_required(VERSION 3.25)

file(REMOVE_RECURSE "${WORK}")
set(ALLOWED "${WORK}/allowed")
set(OUTSIDE "${WORK}/outside")
file(MAKE_DIRECTORY "${ALLOWED}" "${OUTSIDE}")

set(TRI "#usda 1.0\n(\n    metersPerUnit = 1\n    upAxis = \"Y\"\n)\ndef Xform \"Root\"\n{\n    def Mesh \"Tri\"\n    {\n        int[] faceVertexCounts = [3]\n        int[] faceVertexIndices = [0, 1, 2]\n        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]\n    }\n}\n")
file(WRITE "${ALLOWED}/tri.usda" "${TRI}")
file(WRITE "${OUTSIDE}/secret.usda" "${TRI}")

set(HAVE_LINK OFF)
file(CREATE_LINK "${OUTSIDE}/secret.usda" "${ALLOWED}/link.usda" RESULT link_rc SYMBOLIC)
if(link_rc EQUAL 0)
  set(HAVE_LINK ON)
endif()

function(call id tool args)
  set(line "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"tools/call\",\"params\":{\"name\":\"${tool}\",\"arguments\":${args}}}")
  set(REQ "${REQ}${line}\n" PARENT_SCOPE)
endfunction()

set(REQ "")
string(APPEND REQ "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"ctest\",\"version\":\"1\"}}}\n")
string(APPEND REQ "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n")
string(APPEND REQ "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}\n")
call(3 list_formats "{\"kind\":\"model\"}")
call(4 probe "{\"path\":\"${ALLOWED}/tri.usda\"}")
call(5 convert "{\"input\":\"tri.usda\",\"output\":\"tri.glb\"}")
call(6 probe "{\"path\":\"${OUTSIDE}/secret.usda\"}")
call(7 convert "{\"input\":\"${ALLOWED}/tri.usda\",\"output\":\"${OUTSIDE}/stolen.glb\"}")
call(8 convert "{\"input\":\"../outside/secret.usda\",\"output\":\"copy.glb\"}")
if(HAVE_LINK)
  call(9 probe "{\"path\":\"${ALLOWED}/link.usda\"}")
endif()
string(APPEND REQ "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"ping\"}\n")
call(11 no_such_tool "{}")
string(APPEND REQ "{\"jsonrpc\":\"2.0\",\"id\":12,\"method\":\"resources/list\"}\n")
string(APPEND REQ "{not json\n")
file(WRITE "${WORK}/requests.jsonl" "${REQ}")

set(cmd ${JVCONVERT} mcp --allow "${ALLOWED}")
if(EMULATOR)
  separate_arguments(emu NATIVE_COMMAND "${EMULATOR}")
  set(cmd ${emu} ${cmd})
endif()
execute_process(COMMAND ${cmd}
  INPUT_FILE "${WORK}/requests.jsonl"
  OUTPUT_VARIABLE out
  ERROR_VARIABLE err
  RESULT_VARIABLE rc
  TIMEOUT 120)
file(WRITE "${WORK}/responses.jsonl" "${out}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "jvconvert mcp exited with ${rc}: ${err}")
endif()

string(REPLACE ";" "," out "${out}")
string(REPLACE "\n" ";" lines "${out}")
set(failures 0)
set(seen "")
foreach(l IN LISTS lines)
  if(l STREQUAL "")
    continue()
  endif()
  string(JSON id ERROR_VARIABLE e GET "${l}" id)
  if(e)
    message(SEND_ERROR "reply without id: ${l}")
    math(EXPR failures "${failures}+1")
    continue()
  endif()
  if(id STREQUAL "" OR id STREQUAL "null")
    set(id null)
  endif()
  set(R_${id} "${l}")
  list(APPEND seen ${id})
endforeach()

macro(expect cond msg)
  set(_ok OFF)
  cmake_language(EVAL CODE "if(${cond})
  set(_ok ON)
endif()")
  if(NOT _ok)
    message(SEND_ERROR "${msg}")
    math(EXPR failures "${failures}+1")
  endif()
endmacro()

string(JSON v GET "${R_1}" result protocolVersion)
expect("v STREQUAL \"2025-06-18\"" "initialize: protocolVersion ${v}")
string(JSON name GET "${R_1}" result serverInfo name)
expect("name STREQUAL \"jvconvert\"" "initialize: serverInfo.name ${name}")

string(JSON ntools LENGTH "${R_2}" result tools)
expect("ntools EQUAL 3" "tools/list returned ${ntools} tools")

string(JSON isErr GET "${R_3}" result isError)
string(JSON nfmt LENGTH "${R_3}" result structuredContent formats)
expect("NOT isErr AND nfmt GREATER 10" "list_formats: isError=${isErr} count=${nfmt}")

string(JSON isErr GET "${R_4}" result isError)
string(JSON verts GET "${R_4}" result structuredContent vertices)
expect("NOT isErr AND verts EQUAL 3" "probe allowed: isError=${isErr} vertices=${verts}")

string(JSON isErr GET "${R_5}" result isError)
expect("NOT isErr" "convert inside allowed failed: ${R_5}")
expect("EXISTS \"${ALLOWED}/tri.glb\"" "tri.glb was not written")

foreach(id 6 7 8)
  string(JSON isErr GET "${R_${id}}" result isError)
  string(JSON status GET "${R_${id}}" result structuredContent status)
  expect("isErr AND status STREQUAL \"access_denied\"" "request ${id} was not refused: ${R_${id}}")
endforeach()
expect("NOT EXISTS \"${OUTSIDE}/stolen.glb\"" "a file was written outside --allow")
expect("NOT EXISTS \"${ALLOWED}/copy.glb\"" "a file outside --allow was converted")

if(HAVE_LINK)
  string(JSON isErr GET "${R_9}" result isError)
  string(JSON status GET "${R_9}" result structuredContent status)
  expect("isErr AND status STREQUAL \"access_denied\"" "symlink escape was not refused: ${R_9}")
else()
  message(STATUS "symlink check skipped (cannot create symlinks here)")
endif()

string(JSON pong TYPE "${R_10}" result)
expect("pong STREQUAL \"OBJECT\"" "ping failed")
string(JSON code GET "${R_11}" error code)
expect("code EQUAL -32602" "unknown tool code ${code}")
string(JSON code GET "${R_12}" error code)
expect("code EQUAL -32601" "unknown method code ${code}")
string(JSON code GET "${R_null}" error code)
expect("code EQUAL -32700" "parse error code ${code}")

if(failures GREATER 0)
  message(FATAL_ERROR "${failures} MCP check(s) failed; transcript in ${WORK}")
endif()
list(LENGTH seen n)
message(STATUS "MCP session OK (${n} replies)")
