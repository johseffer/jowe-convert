#usda 1.0
(
    customLayerData = {
        string creator = "Model IO export preview 1.10"
    }
    defaultPrim = "triangle_color4f"
    upAxis = "Y"
)

def Xform "triangle_color4f" (
    assetInfo = {
        string name = "triangle_color4f"
    }
    kind = "component"
)
{
    def Scope "Geom"
    {
        def Mesh "Triangle" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(0, 0, 0), (1, 1, 0)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [2, 1, 0]
            rel material:binding = </triangle_color4f/Materials/TriMat>
            normal3f[] normals = [(0, 0, 1), (0, 0, 1), (0, 0, 1)]
            point3f[] points = [(0, 1, 0), (1, 0, 0), (0, 0, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def Scope "Materials"
    {
        def Material "TriMat"
        {
            token outputs:surface.connect = </triangle_color4f/Materials/TriMat/surfaceShader.outputs:surface>

            def Shader "surfaceShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color4f inputs:diffuseColor = (0.8, 0.2, 0.1, 1)
                color4f inputs:emissiveColor = (0.1, 0.3, 0.9, 1)
                float inputs:metallic = 0
                float inputs:opacity = 0.5
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }
}

